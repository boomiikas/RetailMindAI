# Supabase PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
SYNC_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Environment Configuration for RetailMind AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
DATABASE_ECHO=false

# Redis Configuration (Celery & Caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM Configuration (Groq API - Direct Integration)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1

# WhatsApp Meta Cloud API Configuration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=8667754243
WHATSAPP_VERIFY_TOKEN=retailmind_meta_webhook_verify_secret
WHATSAPP_API_VERSION=v21.0
USE_MOCK_WHATSAPP=true

# Security & CORS
SECRET_KEY=dev-retailmind-super-secret-key-32-chars-long!
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
